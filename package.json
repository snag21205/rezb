{
  "name": "cv-interview-coach",
  "version": "1.0.0",
  "description": "AI-powered CV analysis & interview coaching platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @cv-coach/client dev\" \"pnpm --filter @cv-coach/server dev\"",
    "dev:client": "pnpm --filter @cv-coach/client dev",
    "dev:server": "pnpm --filter @cv-coach/server dev",
    "build": "concurrently \"pnpm --filter @cv-coach/client build\" \"pnpm --filter @cv-coach/server build\"",
    "install:all": "pnpm install",
    "lint": "concurrently \"pnpm --filter @cv-coach/client lint\" \"pnpm --filter @cv-coach/server lint\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}